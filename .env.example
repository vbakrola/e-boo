# Ubuntu Lab Manager Environment Variables

APP_NAME="Ubuntu Lab Manager"
APP_VERSION="1.0.0"
ENVIRONMENT="production"

# Secret key used for signing JWT tokens and deriving AES-256-GCM envelope encryption keys
# Generate a strong 32+ character random string in production!
SECRET_KEY="ubuntu-lab-manager-lan-super-secret-key-change-in-prod-12345678"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Network Bindings
HOST="0.0.0.0"
PORT=8000

# SQLite Database
DATABASE_URL="sqlite:///./lab_manager.db"

# Heartbeat & Task Worker Parameters
HEARTBEAT_TIMEOUT_SECONDS=45
TASK_MAX_ATTEMPTS=3
CREDENTIAL_TTL_SECONDS=600

# Next.js Frontend (optional override)
NEXT_PUBLIC_API_URL="http://192.168.1.50:8000"
